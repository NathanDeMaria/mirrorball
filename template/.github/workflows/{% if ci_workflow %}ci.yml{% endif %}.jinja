# Template-owned (mirrorball). One job named `ci`, because that is the check
# the branch ruleset requires: a red `ci` blocks the merge.
name: CI

on:
  push:
    branches: [main]
  pull_request:

# Superseded PR runs are pointless, but let pushes to main finish
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

jobs:
  ci:
    runs-on: ubuntu-latest
    env:
      # Inline annotations on the PR diff instead of plain console output
      RUFF_OUTPUT_FORMAT: github
      TY_OUTPUT_FORMAT: github
    steps:
      - uses: actions/checkout@v7

      # Installs uv, restores its cache keyed on uv.lock, and provisions the
      # interpreter from .python-version -- the same pins as the devcontainer.
      - uses: astral-sh/setup-uv@v7
        with:
          version: "{{ uv_version }}"
          python-version: "{{ python_version }}"
          enable-cache: true

      # --locked: a uv.lock that doesn't match pyproject.toml fails here rather
      # than being quietly re-resolved. Its own step so a resolution failure
      # isn't reported as a lint failure.
      - name: Install dependencies
        run: uv sync --locked

      - name: Lint
        run: make check

      - name: Test
        run: make test
